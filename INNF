    <div id="page-list" class="page">
        <div class="search-bar-container">
            <input type="text" id="word-search-input" class="search-input" placeholder="🔍 単語・意味を検索..." autocomplete="off" oninput="renderWordList()">
        </div>

        <div class="tabs" id="list-tabs-container"></div>

        <div class="pl-actions-container">
            <button class="btn-sub" onclick="toggleBulkActionBar()">選択した項目を操作...</button>
