    <nav class="menu">
        <button id="nav-add" onclick="showPage('add')"><span-icon>📝</span-icon><span>登録</span></button>
        <button id="nav-quiz" class="active-nav" onclick="showPage('quiz')"><span-icon>⚔️</span-icon><span>クイズ</span></button>
        <button id="nav-list" onclick="showPage('list')"><span-icon>🗂️</span-icon><span>一覧</span></button>
        <button id="nav-settings" onclick="showPage('settings')"><span-icon>⚙️</span-icon><span>設定</span></button>
    </nav>

    <script>
        // データモデル定義
        let data = {
            words: [],
            playlists: ["デフォルト"]
        };
        let currentPlaylist = "デフォルト";
        let selectedWordIds = new Set();

        // クイズ状態変数
        let quizWords = [];
        let currentQuizIndex = 0;
        let quizMode = 'new'; 
        let countdownInterval = null;
        let quizTimerTimeout = null;

        // GitHub同期用設定
        let gitHubConfig = {
            username: "",
            repo: "",
            token: "",
            name: "me"
        };

        // ローカルストレージ即座同期
        function saveData() {
            localStorage.setItem("domemory_v75_unified_data", JSON.stringify(data));
        }

        function loadData() {
            const local = localStorage.getItem("domemory_v75_unified_data");
            if (local) {
                try {
                    data = JSON.parse(local);
                    if (!data.playlists || data.playlists.length === 0) {
                        data.playlists = ["デフォルト"];
                    }
                } catch(e) {
                    console.error("データ読み込み失敗", e);
                }
            }
            const ghLocal = localStorage.getItem("domemory_github_config");
            if (ghLocal) {
                try {
                    gitHubConfig = JSON.parse(ghLocal);
                    document.getElementById('gh-user').value = gitHubConfig.username || "";
                    document.getElementById('gh-repo').value = gitHubConfig.repo || "";
                    document.getElementById('gh-token').value = gitHubConfig.token || "";
                    document.getElementById('gh-name').value = gitHubConfig.name || "me";
                } catch(e) {}
            }
        }

        function saveGitHubSettings() {
            gitHubConfig.username = document.getElementById('gh-user').value.trim();
            gitHubConfig.repo = document.getElementById('gh-repo').value.trim();
            gitHubConfig.token = document.getElementById('gh-token').value.trim();
            let inputName = document.getElementById('gh-name').value.trim();
            if(!inputName) inputName = "me";
            gitHubConfig.name = inputName;

            localStorage.setItem("domemory_github_config", JSON.stringify(gitHubConfig));
            showToast(`クラウド接続設定（名義: ${inputName}）を保存しました！`);
        }

        async function uploadToGitHubFile(filename) {
            const { username, repo, token } = gitHubConfig;
            if (!username || !repo || !token) {
                throw new Error("GitHub設定が不完全です。");
            }
            const url = `https://api.github.com/repos/${username}/${repo}/contents/${filename}`;
            const jsonStr = JSON.stringify(data, null, 2);
            const contentBase64 = btoa(unescape(encodeURIComponent(jsonStr)));

            let sha = null;
            try {
                const res = await fetch(url, { headers: { "Authorization": `token ${token}` } });
                if (res.ok) { const fileData = await res.json(); sha = fileData.sha; }
            } catch (e) {}

            const bodyObj = { message: `Update ${filename}`, content: contentBase64 };
            if (sha) bodyObj.sha = sha;

            const putRes = await fetch(url, {
                method: "PUT",
                headers: { "Authorization": `token ${token}`, "Content-Type": "application/json" },
                body: JSON.stringify(bodyObj)
            });
            if (!putRes.ok) throw new Error(`${filename} の送信エラー`);
        }

        async function syncToGitHubCloud() {
            const targetName = gitHubConfig.name || "me";
            const filename = `domemory_data_${targetName}.json`;
            showToast(`クラウドの ${filename} へ送信中...`, false);
            try {
                await uploadToGitHubFile(filename);
                showToast(`☁️ 「${filename}」へ保存完了しました！`);
            } catch (error) {
                showToast("保存に失敗しました。設定を確認してください。", true);
            }
        }

        async function loadFromGitHubCloud() {
            const { username, repo, token, name } = gitHubConfig;
            const targetName = name || "me";
            const filename = `domemory_data_${targetName}.json`;

            if (!username || !repo || !token) {
                showToast("GitHub同期設定が不完全です", true);
                return;
            }
            showToast(`クラウドから ${filename} を読込中...`, false);
            try {
                let response = await fetch(`https://api.github.com/repos/${username}/${repo}/contents/${filename}`, {
                    headers: { "Authorization": `token ${token}` }
                });
                if (!response.ok) throw new Error();
                
                const fileData = await response.json();
                const jsonStr = decodeURIComponent(escape(atob(fileData.content)));
                const downloadedData = JSON.parse(jsonStr);
                
                if (downloadedData && Array.isArray(downloadedData.words)) {
                    data = downloadedData;
                    saveData();
                    updateUI();
                    showToast(`☁️ 名義「${targetName}」から読み込みました！`);
                }
            } catch (error) {
                showToast(`「${filename}」が見つからないか、読込に失敗しました。`, true);
            }
        }

        window.addEventListener('beforeunload', function (e) {
            if (gitHubConfig.username && gitHubConfig.repo && gitHubConfig.token) {
                e.preventDefault(); e.returnValue = '保存しますか？';
            }
        });

        window.addEventListener('pagehide', function() {
            if (gitHubConfig.username && gitHubConfig.repo && gitHubConfig.token) {
                uploadToGitHubFile(`domemory_data_${gitHubConfig.name || "me"}.json`).catch(()=>{});
            }
        });

        function migrateToUnifiedData() {
            loadData();
        }

        function showToast(message, isError = false) {
            const container = document.getElementById("toast-container");
            const toast = document.createElement("div");
            toast.className = `toast ${isError ? 'toast-error' : ''}`;
            toast.innerText = message;
            container.appendChild(toast);
            setTimeout(() => { toast.remove(); }, 3000);
        }

        function showConfirm(title, message, onConfirm) {
            document.getElementById("confirm-title").innerText = title;
            document.getElementById("confirm-msg").innerText = message;
            const modal = document.getElementById("confirm-modal");
            modal.style.display = "flex";
            document.getElementById("confirm-ok-btn").onclick = () => { onConfirm(); modal.style.display = "none"; };
            document.getElementById("confirm-cancel-btn").onclick = () => { modal.style.display = "none"; };
        }

        function closeModal(id) { document.getElementById(id).style.display = "none"; }

        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.menu button').forEach(b => b.classList.remove('active-nav'));
            
            const targetPage = document.getElementById(`page-${pageId}`);
            if(targetPage) targetPage.classList.add('active');
            
            const targetNav = document.getElementById(`nav-${pageId}`);
            if(targetNav) targetNav.classList.add('active-nav');
            
            if(pageId === 'quiz') abortQuiz();
            updateUI();
        }

        function switchAddMode(mode) {
            document.getElementById('sub-tab-single').classList.toggle('sub-tab-active', mode === 'single');
            document.getElementById('sub-tab-bulk').classList.toggle('sub-tab-active', mode === 'bulk');
            document.getElementById('add-single-container').classList.toggle('hidden', mode !== 'single');
            document.getElementById('add-bulk-container').classList.toggle('hidden', mode !== 'bulk');
        }

        function updatePlaylistDropdowns() {
            const addSelect = document.getElementById("add-to-playlist");
            const quizSelect = document.getElementById("quiz-from-playlist");
            if(!addSelect || !quizSelect) return;

            const prevQuizVal = quizSelect.value;
            addSelect.innerHTML = ""; quizSelect.innerHTML = "";

            const optAll = document.createElement("option");
            optAll.value = "__ALL__"; optAll.innerText = "全フォルダ対象";
            quizSelect.appendChild(optAll);

            data.playlists.forEach(pl => {
                const opt1 = document.createElement("option"); opt1.value = pl; opt1.innerText = pl; addSelect.appendChild(opt1);
                const opt2 = document.createElement("option"); opt2.value = pl; opt2.innerText = pl; quizSelect.appendChild(opt2);
            });

            addSelect.value = currentPlaylist;
            if(prevQuizVal && [...quizSelect.options].some(o => o.value === prevQuizVal)) {
                quizSelect.value = prevQuizVal;
            } else {
                quizSelect.value = "__ALL__";
            }
        }

        function createPlaylist() {
            const inputEl = document.getElementById("new-playlist-name");
            const name = inputEl.value.trim();
            if(!name) return;
            if(data.playlists.includes(name)) { showToast("既に同名のフォルダが存在します", true); return; }
            
            data.playlists.push(name);
            inputEl.value = ""; 
            saveData(); updateUI();
            showToast(`リスト「${name}」を作成しました！`);
        }

        function saveWord() {
            const en = document.getElementById("en-in").value.trim();
            const ja = document.getElementById("ja-in").value.trim();
            const playlist = document.getElementById("add-to-playlist").value;

            if(!en || !ja) { showToast("英語と日本語の両方を入力してください", true); return; }

            data.words.unshift({
                id: "w-" + Date.now() + Math.random(), en, ja, playlist,
                status: "new", missCount: 0, lastTested: null, nextReview: null, interval: 0
            });
            currentPlaylist = playlist;
            saveData();
            document.getElementById("en-in").value = "";
            document.getElementById("ja-in").value = "";
            document.getElementById("en-in").focus();
            showToast("単語を登録しました！");
            updateUI();
        }

        function saveBulkWords() {
            const text = document.getElementById("bulk-import-area").value;
            const playlist = document.getElementById("add-to-playlist").value;
            if(!text.trim()) { showToast("テキストが空です", true); return; }

            const lines = text.split('\n');
            let successCount = 0;

            lines.forEach(line => {
                if(!line.trim()) return;
                let parts = line.split(',');
                if(parts.length < 2) parts = line.split('，'); 
                if(parts.length < 2) parts = line.split('\t'); 

                if(parts.length >= 2) {
                    const en = parts[0].trim();
                    const ja = parts.slice(1).join(',').trim();
                    if(en && ja) {
                        data.words.unshift({
                            id: "w-" + Date.now() + Math.random(), en, ja, playlist,
                            status: "new", missCount: 0, lastTested: null, nextReview: null, interval: 0
                        });
                        successCount++;
                    }
                }
            });

            if(successCount > 0) {
                currentPlaylist = playlist; saveData();
                document.getElementById("bulk-import-area").value = "";
                showToast(`${successCount}件の一括登録に成功！`);
                updateUI();
            } else {
                showToast("有効な行が見つかりませんでした", true);
            }
        }

        let editingWordId = null;
        function openEditModal(id) {
            editingWordId = id;
            const w = data.words.find(item => item.id === id);
            if(!w) return;
            document.getElementById("edit-en-in").value = w.en;
            document.getElementById("edit-ja-in").value = w.ja;
            document.getElementById("edit-modal").style.display = "flex";
        }
        function executeEditWord() {
            const en = document.getElementById("edit-en-in").value.trim();
            const ja = document.getElementById("edit-ja-in").value.trim();
            if(!en || !ja) return;
            const w = data.words.find(item => item.id === editingWordId);
            if(w) { w.en = en; w.ja = ja; saveData(); updateUI(); showToast("更新しました"); }
            closeModal('edit-modal');
        }

        function deleteWord(id) {
            showConfirm("削除確認", "この単語を削除しますか？", () => {
                data.words = data.words.filter(w => w.id !== id);
                selectedWordIds.delete(id); saveData(); updateUI(); showToast("削除しました");
            });
        }

        function resetWordSRS(id) {
            const w = data.words.find(item => item.id === id);
            if(w) {
                w.status = "new"; w.missCount = 0; w.lastTested = null; w.nextReview = null; w.interval = 0;
                saveData(); updateUI(); showToast("SRSリセット完了");
            }
        }

        function toggleItemSelection(id) {
            if(selectedWordIds.has(id)) selectedWordIds.delete(id);
            else selectedWordIds.add(id);
            updateBulkActionBarUI();
        }
        function toggleSelectAllItems() {
            const query = document.getElementById("word-search-input").value.toLowerCase().trim();
            const filtered = data.words.filter(w => {
                const matchTab = (currentPlaylist === "__ALL__" || w.playlist === currentPlaylist);
                const matchQuery = !query || w.en.toLowerCase().includes(query) || w.ja.toLowerCase().includes(query);
                return matchTab && matchQuery;
            });
            const allSelected = filtered.every(w => selectedWordIds.has(w.id));
            filtered.forEach(w => {
                if(allSelected) selectedWordIds.delete(w.id);
                else selectedWordIds.add(w.id);
            });
            updateBulkActionBarUI(); renderWordList();
        }
        function toggleBulkActionBar() { document.getElementById("bulk-action-bar").classList.toggle("hidden"); }
        function updateBulkActionBarUI() { document.getElementById("selected-count").innerText = selectedWordIds.size; }
        
        function openBulkMoveModal() {
            if(selectedWordIds.size === 0) { showToast("選択されていません", true); return; }
            const select = document.getElementById("modal-pl-select"); select.innerHTML = "";
            data.playlists.forEach(pl => {
                const opt = document.createElement("option"); opt.value = pl; opt.innerText = pl; select.appendChild(opt);
            });
            document.getElementById("list-modal").style.display = "flex";
        }
        function executeAddToList() {
            const targetPl = document.getElementById("modal-pl-select").value;
            data.words.forEach(w => { if(selectedWordIds.has(w.id)) w.playlist = targetPl; });
            saveData(); selectedWordIds.clear(); closeModal('list-modal'); updateUI(); showToast("移動完了");
        }
        function executeBulkDelete() {
            if(selectedWordIds.size === 0) return;
            showConfirm("一括削除", `${selectedWordIds.size}件を本当に削除しますか？`, () => {
                data.words = data.words.filter(w => !selectedWordIds.has(w.id));
                selectedWordIds.clear(); saveData(); updateUI(); showToast("一括削除しました");
            });
        }
        function executeBulkResetSRS() {
            if(selectedWordIds.size === 0) return;
            showConfirm("一括リセット", `${selectedWordIds.size}件の進捗を初期化しますか？`, () => {
                data.words.forEach(w => {
                    if(selectedWordIds.has(w.id)) {
                        w.status = "new"; w.missCount = 0; w.lastTested = null; w.nextReview = null; w.interval = 0;
                    }
                });
                saveData(); selectedWordIds.clear(); updateUI(); showToast("初期化しました");
            });
        }

        // 横スライドタブと収録語数の正確な計算レンダリング
        function renderTabs() {
            const container = document.getElementById("list-tabs-container");
            if(!container) return;
            container.innerHTML = "";

            const allTabs = ["__ALL__", ...data.playlists];
            allTabs.forEach(tabName => {
                // 正確にリアルタイムの全単語データを数える
                const count = tabName === "__ALL__" ? data.words.length : data.words.filter(w => w.playlist === tabName).length;
                
                const btn = document.createElement("div");
                btn.className = `tab ${currentPlaylist === tabName ? 'tab-active' : ''}`;
                btn.innerText = `${tabName === '__ALL__' ? '全て' : tabName} (${count})`;
                btn.onclick = () => { currentPlaylist = tabName; selectedWordIds.clear(); updateUI(); };
                container.appendChild(btn);
            });
        }

        // 単語リストの表示（検索バーとのリアルタイム連動）
        function renderWordList() {
            const container = document.getElementById("word-list-container");
            if(!container) return;
            container.innerHTML = "";

            const searchQuery = document.getElementById("word-search-input") ? document.getElementById("word-search-input").value.toLowerCase().trim() : "";

            // フォルダ判定 ＋ 検索クエリ判定
            const filtered = data.words.filter(w => {
                const matchTab = (currentPlaylist === "__ALL__" || w.playlist === currentPlaylist);
                const matchSearch = !searchQuery || w.en.toLowerCase().includes(searchQuery) || w.ja.toLowerCase().includes(searchQuery);
                return matchTab && matchSearch;
            });

            if(filtered.length === 0) {
                container.innerHTML = `<p style="text-align:center; color:#543f2f; font-size:13px; margin-top:15px;">対象の単語が見つかりません</p>`;
                return;
            }

            filtered.forEach(w => {
                const card = document.createElement("div");
                card.className = `card li-item status-${w.status || 'new'}`;

                let badgeTxt = w.status === 'wait' ? "復習待ち" : w.status === 'miss' ? "苦手" : "新規";
                let dueTxt = "";
                if(w.status === 'wait' && w.nextReview) {
                    const diff = w.nextReview - Date.now();
                    if(diff <= 0) dueTxt = "⏱️ 復習可能";
                    else {
                        const mins = Math.ceil(diff / 60000);
                        dueTxt = mins > 60 ? `⏱️ 約${Math.ceil(mins/60)}時間後` : `⏱️ あと${mins}分`;
                    }
                }

                const isChecked = selectedWordIds.has(w.id) ? "checked" : "";

                card.innerHTML = `
                    <div class="li-checkbox-area">
                        <input type="checkbox" class="li-checkbox" ${isChecked} onchange="toggleItemSelection('${w.id}')">
                    </div>
                    <div class="li-info" onclick="openEditModal('${w.id}')">
                        <div style="font-weight:bold; font-size:17px; color:#000;">${w.en}</div>
                        <div style="font-size:13px; color:#342a1e; margin-top:1px;">${w.ja}</div>
                        <div>
                            <span class="badge">${badgeTxt}</span>
                            ${dueTxt ? `<span class="due-timer">${dueTxt}</span>` : ''}
                            ${currentPlaylist === '__ALL__' ? `<span class="badge" style="background:rgba(0,0,0,0.04); color:#555;">📁${w.playlist}</span>` : ''}
                        </div>
                    </div>
                    <div class="action-btns">
                        <button class="btn-edit" onclick="openEditModal('${w.id}')">編集</button>
                        <button class="btn-sub" onclick="resetWordSRS('${w.id}')">リセット</button>
                        <button class="btn-d" onclick="deleteWord('${w.id}')">削除</button>
                    </div>
                `;
                container.appendChild(card);
            });
            updateBulkActionBarUI();
        }

        function updateUI() {
            updatePlaylistDropdowns();
            renderTabs();
            renderWordList();
            
            const quizTarget = document.getElementById("quiz-from-playlist") ? document.getElementById("quiz-from-playlist").value : "__ALL__";
            const pool = data.words.filter(w => quizTarget === "__ALL__" || w.playlist === quizTarget);
            const msgEl = document.getElementById("limit-msg");
            if(msgEl) {
                msgEl.innerText = pool.length < 4 ? `⚠️ 単語数が不足しています (現在:${pool.length}/4件)` : `✅ 開始可能 (対象:${pool.length}件)`;
            }
        }

        // ==================== クイズシステム ====================
        function startQuiz(mode) {
            const targetPl = document.getElementById("quiz-from-playlist").value;
            let pool = data.words.filter(w => targetPl === "__ALL__" || w.playlist === targetPl);
            if(pool.length < 4) { showToast("単語数が4件未満です。", true); return; }

            quizMode = mode; const now = Date.now();
            if(mode === 'new') quizWords = pool.filter(w => !w.status || w.status === 'new');
            else if(mode === 'srs') quizWords = pool.filter(w => w.status === 'wait' && w.nextReview && w.nextReview <= now);
            else if(mode === 'miss') quizWords = pool.filter(w => w.missCount && w.missCount > 0).sort((a,b) => b.missCount - a.missCount);
            else quizWords = [...pool];

            if(quizWords.length === 0) { showToast("対象となる単語がありません。", false); return; }

            quizWords.sort(() => Math.random() - 0.5);
            if(mode !== 'miss' && quizWords.length > 20) quizWords = quizWords.slice(0, 20);

            currentQuizIndex = 0;
            document.getElementById("quiz-setup").classList.add("hidden");
            document.getElementById("abort-ui").classList.remove("hidden");
            nextQuestion();
        }

        function abortQuiz() {
            clearTimeout(quizTimerTimeout); clearInterval(countdownInterval);
            document.getElementById("quiz-ui").classList.add("hidden");
            document.getElementById("choice-ui").classList.add("hidden");
            document.getElementById("abort-ui").classList.add("hidden");
            document.getElementById("quiz-setup").classList.remove("hidden");
            document.getElementById("q-display").innerText = "クイズ道場";
        }

        function nextQuestion() {
            if(currentQuizIndex >= quizWords.length) {
                document.getElementById("complete-modal").style.display = "flex"; abortQuiz(); return;
            }
            const w = quizWords[currentQuizIndex];
            document.getElementById("q-display").innerText = w.en;

            if(quizMode === 'all' || quizMode === 'miss' && Math.random() > 0.6) {
                document.getElementById("quiz-ui").classList.remove("hidden");
                document.getElementById("choice-ui").classList.add("hidden");
                const inEl = document.getElementById("ans-in"); inEl.value = "";
                setTimeout(() => { inEl.focus(); }, 50);
            } else {
                document.getElementById("quiz-ui").classList.add("hidden");
                document.getElementById("choice-ui").classList.remove("hidden");
                setupChoices(w);
            }
        }

        function setupChoices(correctWord) {
            const waitArea = document.getElementById("wait-area");
            const grid = document.getElementById("choices-grid");
            const timerTxt = document.getElementById("wait-timer");

            grid.classList.add("hidden"); grid.classList.remove("choices-disabled"); waitArea.classList.remove("hidden");
            const choiceCount = quizMode === 'srs' ? 6 : 4;
            
            let targetPl = document.getElementById("quiz-from-playlist").value;
            let siblings = data.words.filter(w => (targetPl === "__ALL__" || w.playlist === targetPl) && w.id !== correctWord.id);
            if(siblings.length < choiceCount - 1) siblings = data.words.filter(w => w.id !== correctWord.id);
            
            siblings.sort(() => Math.random() - 0.5);
            let selectedChoices = siblings.slice(0, choiceCount - 1);
            selectedChoices.push(correctWord); selectedChoices.sort(() => Math.random() - 0.5);

            grid.innerHTML = "";
            selectedChoices.forEach(c => {
                const btn = document.createElement("div"); btn.className = "choice-btn"; btn.innerText = c.ja;
                btn.onclick = () => handleChoiceCheck(c.id === correctWord.id, correctWord);
                grid.appendChild(btn);
            });

            let waitSeconds = correctWord.missCount ? 2 + Math.min(6, correctWord.missCount * 2) : 2;
            timerTxt.innerText = `選択肢表示まであと ${waitSeconds} 秒`;
            
            clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
                waitSeconds--;
                if(waitSeconds <= 0) { clearInterval(countdownInterval); waitArea.classList.add("hidden"); grid.classList.remove("hidden"); }
                else timerTxt.innerText = `選択肢表示まであと ${waitSeconds} 秒`;
            }, 1000);

            clearTimeout(quizTimerTimeout);
            quizTimerTimeout = setTimeout(() => { clearInterval(countdownInterval); waitArea.classList.add("hidden"); grid.classList.remove("hidden"); }, waitSeconds * 1000);
        }

        function skipWait() {
            clearInterval(countdownInterval); clearTimeout(quizTimerTimeout);
            document.getElementById("wait-area").classList.add("hidden"); document.getElementById("choices-grid").classList.remove("hidden");
        }

        function handleCheck() {
            const inEl = document.getElementById("ans-in"); const userAns = inEl.value.trim().toLowerCase();
            const w = quizWords[currentQuizIndex]; if(!userAns) return;
            processResult(w.ja.toLowerCase().includes(userAns) || userAns === w.ja.toLowerCase(), w);
        }

        function handleChoiceCheck(isCorrect, w) {
            document.getElementById("choices-grid").classList.add("choices-disabled"); processResult(isCorrect, w);
        }

        function processResult(isCorrect, w) {
            clearInterval(countdownInterval); clearTimeout(quizTimerTimeout);
            const overlay = document.getElementById("bg-effect-overlay");
            const effectLayer = document.getElementById("quiz-effect-layer"); effectLayer.innerHTML = "";
            const mainDataWord = data.words.find(item => item.id === w.id);

            if(isCorrect) {
                overlay.className = "bg-correct-active"; setTimeout(() => { overlay.className = ""; }, 250);
                const box = document.createElement("div"); box.className = "quiz-effect-box";
                box.innerHTML = `<div class="quiz-effect-txt txt-correct">💮 CORRECT !!</div>`;
                effectLayer.appendChild(box);

                for(let i=0; i<15; i++){
                    const p = document.createElement("div"); p.className = "particle";
                    p.style.backgroundColor = `hsl(${Math.random()*360}, 100%, 50%)`;
                    p.style.setProperty('--mx', `${(Math.random()-0.5)*200}px`); p.style.setProperty('--my', `${(Math.random()-0.5)*200}px`);
                    box.appendChild(p);
                }

                if(mainDataWord) {
                    mainDataWord.lastTested = Date.now();
                    if(mainDataWord.status === 'new' || !mainDataWord.status || mainDataWord.status === 'miss') {
                        mainDataWord.interval = 1; mainDataWord.status = 'wait';
                    } else { mainDataWord.interval = mainDataWord.interval * 2 + 1; }
                    mainDataWord.nextReview = Date.now() + (mainDataWord.interval * 60 * 1000); 
                }
            } else {
                overlay.className = "bg-miss-active"; setTimeout(() => { overlay.className = ""; }, 250);
                const box = document.createElement("div"); box.className = "quiz-effect-box";
                box.innerHTML = `<div class="quiz-effect-txt txt-miss">❌ MISS</div><div class="miss-ans-subtext">正解: ${w.ja}</div>`;
                effectLayer.appendChild(box);

                if(mainDataWord) {
                    mainDataWord.lastTested = Date.now(); mainDataWord.missCount = (mainDataWord.missCount || 0) + 1;
                    mainDataWord.status = 'miss'; mainDataWord.interval = 0; mainDataWord.nextReview = null; 
                }
            }

            saveData();
            setTimeout(() => { effectLayer.innerHTML = ""; currentQuizIndex++; nextQuestion(); }, isCorrect ? 900 : 1850);
        }

        // ==================== 都会の夜景ハイウェイ背景アニメーション ====================
        const canvas = document.getElementById('highway-canvas'); const ctx = canvas?.getContext('2d');
        let backgroundLines = [];
        function resizeCanvas() { if(!canvas) return; canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        function initLines() {
            backgroundLines = [];
            for (let i = 0; i < 20; i++) {
                backgroundLines.push({
                    x: Math.random() * window.innerWidth, y: Math.random() * window.innerHeight,
                    length: Math.random() * 60 + 30, speed: Math.random() * 3 + 2,
                    color: Math.random() > 0.5 ? '#ff0c00' : '#00ff80' 
                });
            }
        }
        function animateCity() {
            if(!ctx || !canvas) return; ctx.clearRect(0, 0, canvas.width, canvas.height);
            backgroundLines.forEach(l => {
                ctx.beginPath(); ctx.moveTo(l.x, l.y); ctx.lineTo(l.x + l.length, l.y);
                ctx.strokeStyle = l.color; ctx.lineWidth = 1.2; ctx.stroke();
                l.x += l.speed; if (l.x > canvas.width) { l.x = -l.length; l.y = Math.random() * canvas.height; }
            });
            requestAnimationFrame(animateCity);
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas(); initLines(); animateCity();

        // キーボード表示等によるスクロールバグスマホ最適化
        document.addEventListener('focusout', (e) => {
            if (['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName)) {
                setTimeout(() => { window.scrollTo({ top: 0, left: 0, behavior: 'smooth' }); }, 60);
            }
        });
        document.addEventListener('focusin', (e) => {
            if (['INPUT', 'TEXTAREA'].includes(e.target.tagName)) {
                setTimeout(() => { e.target.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 120);
            }
        });

        // 起動時初期化
        migrateToUnifiedData();
        updateUI();
        showPage('quiz');
    </script>
</body>
</html>
