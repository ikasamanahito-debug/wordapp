    <div id="page-settings" class="page">
        <div class="card" style="border: 2px solid var(--gold);">
            <h3 style="margin:0 0 8px 0; color:var(--gold);">☁️ GitHub クラウド同期設定</h3>
            
            <label style="font-size:11px; font-weight:bold;">GitHub ユーザー名</label>
            <input id="gh-user" type="text" placeholder="example-user" autocomplete="off" style="padding:8px; margin:2px 0 8px 0;">
            
            <label style="font-size:11px; font-weight:bold;">リポジトリ名</label>
            <input id="gh-repo" type="text" placeholder="my-domemory-db" autocomplete="off" style="padding:8px; margin:2px 0 8px 0;">
            
            <label style="font-size:11px; font-weight:bold;">パーソナルアクセストークン (ghp_...)</label>
            <input id="gh-token" type="password" placeholder="ghp_xxxxxxxx" autocomplete="off" style="padding:8px; margin:2px 0 8px 0;">

            <label style="font-size:11px; color:var(--p); font-weight:bold;">あなたのなまえ（データ識別キー: me や A）</label>
            <input id="gh-name" type="text" placeholder="me" autocomplete="off" style="padding:8px; margin:2px 0 10px 0; border-color:var(--p);">
            
            <button class="main-btn btn-edit" style="width:100%; margin-bottom:8px; background:linear-gradient(135deg, var(--gold), #001299);" onclick="saveGitHubSettings()">設定を保存</button>
            
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; margin-top:4px;">
                <button class="main-btn" style="background:linear-gradient(135deg, #00ff80, #00994d); color:#000; padding:10px 4px; font-size:13px;" onclick="syncToGitHubCloud()">クラウドへ保存</button>
                <button class="main-btn" style="background:linear-gradient(135deg, #00cccc, #008080); color:#000; padding:10px 4px; font-size:13px;" onclick="loadFromGitHubCloud()">クラウドから読込</button>
            </div>
        </div>

        <div class="card">
            <h3 style="margin:0 0 8px 0;">新規フォルダ作成</h3>
            <div style="display:flex; gap:6px;">
                <input id="new-playlist-name" type="text" placeholder="例: Eiken Pre-1" autocomplete="off" style="margin:0;">
                <button class="main-btn btn-p" style="width:auto; padding:0 15px; white-space:nowrap;" onclick="createPlaylist()">作成</button>
            </div>
        </div>
