<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Domemory v76 - Stream Highway Edition</title>
    <style>
        /* ==================== さわやかポップサイバー テーマ定義（真反対に反転） ==================== */
        :root { 
            --p: #ff0c00;            /* #00f3ff の反転（シアン → 赤・オレンジ） */
            --p-dark: #ff4733;       /* #00b8cc の反転 */
            --bg: #f9f2e9;           /* #060d16 の反転（深いネイビー → 明るい生成り・ベージュ） */
            --acc: #00ff80;          /* #ff007f の反転（マゼンタピンク → 明るいグリーン） */
            --danger: #00cccc;       /* #ff3333 の反転（赤 → シアン・水色） */
            --new: #ff0033;          /* #00ffcc の反転（ミントグリーン → ディープピンク・赤） */
            --text: #000000;         /* #ffffff の反転（白 → 黒） */
            --text-dark: #eeeffd;    /* #111822 の反転（濃い紺 → 薄いラベンダーグレー） */
            --gold: #0019ff;         /* #ffe600 の反転（ゴールド → 鮮やかなブルー） */
            --shuffle: #4fd900;      /* #b026ff の反転（パープル → ライトグリーン） */
            --card-bg: rgba(239, 231, 219, 0.85); /* rgba(16, 24, 36, 0.85) の反転 */
        }
        
        * { 
            -webkit-tap-highlight-color: transparent; 
            box-sizing: border-box; 
        }
        
        body { 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; 
            background: var(--bg); 
            margin: 0; 
            color: var(--text); 
            padding-bottom: calc(85px + env(safe-area-inset-bottom, 16px)); 
            overflow-x: hidden; 
            position: relative; 
            min-height: 100dvh; 
        }

        button, .card, .sub-tab, .tab, .choice-btn {
            touch-action: manipulation;
        }

        /* ==================== 都会の夜景ハイウェイ・動的Canvas背景 ==================== */
        .city-bg-container {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100dvh;
            z-index: -1; pointer-events: none;
            overflow: hidden;
            background-color: var(--bg);
        }
        .city-base-image {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: url('http://googleusercontent.com/image_generation_content/16') center center / cover no-repeat;
            z-index: 1;
            opacity: 0.6;
        }
        #highway-canvas {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 2;
            mix-blend-mode: multiply;
            opacity: 0.1;
        }

        .page { 
            padding: 12px; 
            width: 100%;
            max-width: 500px; 
            margin: 0 auto; 
            display: none; 
            position: relative; 
            z-index: 10; 
            overflow-x: hidden;
        }
        .active { display: block; }
        
        #page-add, #page-quiz {
            min-height: calc(100dvh - 90px);
            display: none;
            flex-direction: column;
            justify-content: center; 
            align-items: center;     
            width: 100%;
            padding: 10px;
        }
        #page-add.active, #page-quiz.active {
            display: flex;
        }

        .card { 
            background: var(--card-bg); 
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 16px; 
            border-radius: 14px; 
            box-shadow: 0 6px 24px rgba(255, 12, 0, 0.12); 
            margin-bottom: 12px; 
            border: 1px solid rgba(255, 12, 0, 0.22); 
            position: relative; 
            transition: all 0.3s ease; 
            width: 100%; 
            max-width: 100%;
            z-index: 10; 
            color: #000000; 
        }

        .menu { 
            background: rgba(249, 242, 233, 0.95); 
            backdrop-filter: blur(15px); 
            -webkit-backdrop-filter: blur(15px); 
            color: #000; 
            position: fixed; 
            bottom: 0; left: 0; right: 0; 
            display: flex; 
            justify-content: space-around; 
            padding: 8px 0 calc(8px + env(safe-area-inset-bottom, 12px)) 0; 
            z-index: 2000; 
            border-top: 2px solid rgba(255, 12, 0, 0.3); 
            box-shadow: 0 -4px 20px rgba(255, 12, 0, 0.1); 
        }
        .menu button { 
            height: 44px;
            background: none; 
            color: #8f7764; 
            font-size: 11px; 
            font-weight: bold;
            border: none; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center;
            gap: 2px; 
            flex: 1; 
            cursor: pointer; 
            transition: color 0.2s ease;
        }
        .menu button span-icon {
            font-size: 18px;
        }
        .menu button.active-nav { 
            color: var(--p); 
            text-shadow: 0 0 8px rgba(255, 12, 0, 0.5); 
        }

        .status-miss { background-color: rgba(0, 255, 128, 0.12) !important; border-left: 5px solid var(--acc); border-right: 1px solid var(--acc); } 
        .status-new { background-color: rgba(255, 0, 51, 0.08) !important; border-left: 5px solid var(--new); } 
        .status-wait { background-color: rgba(255, 12, 0, 0.08) !important; border-left: 5px solid var(--p); } 
        .status-veteran { background-color: rgba(0, 25, 255, 0.08) !important; border-left: 5px solid var(--gold); border: 1px solid var(--gold); } 

        input, select, textarea { 
            width: 100%; 
            max-width: 100%;
            padding: 11px 14px; 
            margin: 6px 0; 
            font-size: 15px !important; 
            border: 2px solid rgba(255, 12, 0, 0.25); 
            border-radius: 9px; 
            outline: none; 
            scroll-margin-top: 80px;
            background: rgba(0, 0, 0, 0.95); 
            color: var(--text-dark);
            font-family: inherit; 
            transition: border-color 0.2s;
        }
        input:focus, select:focus, textarea:focus {
            border-color: var(--p);
            box-shadow: 0 0 6px rgba(255, 12, 0, 0.4); 
        }
        textarea { resize: vertical; min-height: 100px; }

        .search-bar-container {
            margin-bottom: 10px;
            width: 100%;
        }
        .search-input {
            background: rgba(255, 255, 255, 0.9);
            color: #000;
            border: 2px solid rgba(255, 12, 0, 0.3);
            font-weight: 500;
        }
        .search-input::placeholder {
            color: #777;
        }

        .main-btn { 
            width: 100%; 
            max-width: 100%;
            padding: 12px; 
            border: none; 
            border-radius: 9px; 
            font-size: 15px; 
            font-weight: bold; 
            cursor: pointer; 
            transition: all 0.2s ease;
        }
        .main-btn:active { transform: scale(0.98); }
        
        .btn-p { background: linear-gradient(135deg, var(--p), var(--p-dark)); color: var(--text-dark); }
        .btn-sub { background: rgba(0, 0, 0, 0.08); color: #000; padding: 5px 8px; font-size: 11px; border: 1px solid rgba(0,0,0,0.15); border-radius: 5px; cursor: pointer; } 
        .btn-edit { background: linear-gradient(135deg, var(--gold), #1122cc); color: var(--text-dark); padding: 5px 8px; font-size: 11px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; } 
        .btn-d { background: linear-gradient(135deg, var(--danger), #33dbdb); color: #000; padding: 5px 8px; border: none; border-radius: 5px; font-size: 11px; cursor: pointer; font-weight: bold; } 
        
        .q-text { font-size: 28px; font-weight: bold; margin: 20px 0; text-align: center; word-break: break-all; color: #000000; } 
        .countdown { font-size: 70px; color: var(--p); text-align: center; font-weight: bold; margin: 15px 0; text-shadow: 0 0 15px rgba(255, 12, 0, 0.6); } 
        
        #quiz-ui-container { position: relative; width: 100%; }

        .choices-grid { display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 12px; width: 100%; }
        .choice-btn { background: rgba(0, 0, 0, 0.95); border: 2px solid rgba(255, 12, 0, 0.15); padding: 14px; border-radius: 10px; font-size: 15px; font-weight: bold; color: var(--text-dark); text-align: center; cursor: pointer; transition: all 0.1s ease; } 
        .choice-btn:active { transform: scale(0.97); background: var(--p); color: var(--text-dark); }
        .choices-disabled .choice-btn { pointer-events: none; opacity: 0.4; } 

        .wait-timer { font-size: 14px; color: var(--new); text-align: center; margin-bottom: 8px; font-weight: bold; } 

        .tabs { 
            display: flex; 
            overflow-x: auto; 
            overflow-y: hidden;
            gap: 6px; 
            padding: 6px 2px; 
            width: 100%; 
            -webkit-overflow-scrolling: touch; 
        }
        .tabs::-webkit-scrollbar { display: none; }
        
        .tab { 
            display: inline-block;
            white-space: nowrap; 
            background: rgba(0,0,0,0.06); 
            border: 1px solid rgba(255,12,0,0.15); 
            padding: 6px 12px; 
            border-radius: 16px; 
            font-size: 12px; 
            color: #000; 
            cursor: pointer; 
            flex-shrink: 0; 
        }
        .tab-active { background: var(--p); color: var(--text-dark); font-weight: bold; border-color: var(--p); } 

        .sub-tabs { display: flex; gap: 4px; background: rgba(255,255,255,0.4); padding: 3px; border-radius: 8px; margin-bottom: 12px; border: 1px solid rgba(0,0,0,0.08); width: 100%; } 
        .sub-tab { flex: 1; text-align: center; padding: 8px; font-size: 12px; font-weight: bold; color: #5f4f3f; border-radius: 6px; cursor: pointer; } 
        .sub-tab-active { background: var(--p); color: var(--text-dark); } 

        .li-item { display: flex; justify-content: space-between; align-items: center; gap: 8px; position: relative; padding: 12px; width: 100%; }
        .li-checkbox-area { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .li-checkbox { width: 22px; height: 22px; cursor: pointer; accent-color: var(--p); margin: 0; }
        .li-info { flex: 1; min-width: 0; word-break: break-all; padding-left: 4px; } 
        .action-btns { display: flex; flex-direction: column; gap: 4px; flex-shrink: 0; justify-content: center; width: 66px; } 
        .action-btns button { text-align: center; width: 100%; padding: 5px 2px; font-size: 10px; }

        .badge { display: inline-block; padding: 2px 6px; font-size: 10px; border-radius: 3px; margin-top: 4px; font-weight: bold; background: rgba(0,0,0,0.1); color: #000; } 
        .due-timer { font-size: 10px; color: #543f2f; margin-top: 4px; margin-left: 4px; display: inline-block; } 

        .modal-overlay { display:none; position:fixed; top:0; left:0; width:100%; height:100dvh; background:rgba(251, 247, 240, 0.8); z-index:3000; align-items:center; justify-content:center; backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); padding: 20px; } 
        .hidden { display: none !important; }
        .abort-container { margin-top: 15px; text-align: center; border-top: 1px dashed rgba(255,12,0,0.2); padding-top: 10px; width: 100%; } 
        
        .pl-actions-container { display: flex; justify-content: flex-end; gap: 6px; margin-bottom: 10px; width: 100%; margin-top:4px; }
        .bulk-action-bar { background: rgba(239, 231, 219, 0.95); border: 2px solid var(--p); border-radius: 12px; padding: 12px; margin-bottom: 12px; width: 100%; } 

        .prompt-example-box { background: rgba(0,0,0,0.04); border-left: 4px solid var(--p); padding: 10px; border-radius: 0 6px 6px 0; margin-top: 12px; font-size: 11px; color: #333; line-height: 1.4; width: 100%; } 
        .prompt-code-block { background: rgba(255,255,255,0.4); border: 1px solid rgba(255,12,0,0.15); color: #ff0033; padding: 8px; border-radius: 5px; margin-top: 4px; font-family: monospace; white-wrap: pre-wrap; word-break: break-all; font-size: 10px; } 
        
        .mode-desc-container { margin-top: 15px; border-top: 1px dashed rgba(255,12,0,0.2); padding-top: 12px; width: 100%; } 
        .mode-desc-title { font-size: 12px; font-weight: bold; color: var(--p); margin-bottom: 8px; }
        .mode-desc-item { background: rgba(0,0,0,0.02); border: 1px solid rgba(0,0,0,0.08); border-radius: 6px; padding: 8px 10px; margin-bottom: 6px; font-size: 11px; color: #342a1e; } 
        .mode-desc-tag { display: inline-block; padding: 1px 5px; font-size: 9px; font-weight: bold; border-radius: 3px; color: var(--text-dark); margin-right: 4px; }

        #toast-container { position: fixed; top: 20px; left: 0; right: 0; margin: 0 auto; z-index: 9999; width: 90%; max-width: 400px; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
        .toast { background: rgba(239, 231, 219, 0.95); color: #000; padding: 12px 16px; border-radius: 10px; font-size: 13px; font-weight: bold; box-shadow: 0 6px 20px rgba(255,12,0,0.2); display: flex; align-items: center; justify-content: center; animation: toastIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards, toastOut 0.3s ease 2.7s forwards; border-left: 5px solid var(--p); pointer-events: auto; width: 100%; text-align: center; } 
        .toast.toast-error { border-left-color: var(--danger); } 
        @keyframes toastIn { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes toastOut { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-20px); } }

        #bg-effect-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100dvh; pointer-events: none; z-index: 5; opacity: 0; transition: all 0.2s ease; }
        .bg-correct-active { opacity: 1 !important; background: rgba(255, 0, 51, 0.1); } 
        .bg-miss-active { opacity: 1 !important; background: rgba(0, 255, 128, 0.15) !important; } 

        #quiz-effect-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1500; display: flex; justify-content: center; align-items: center; }
        .quiz-effect-box { background: rgba(244, 235, 221, 0.96); padding: 14px 20px; border-radius: 10px; box-shadow: 0 6px 24px rgba(255,12,0,0.25); border: 1px solid rgba(255,12,0,0.25); display: inline-flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; }
        .quiz-effect-txt { font-size: 34px; font-weight: 900; letter-spacing: 1px; text-align: center; width: 100%; }
        
        .txt-correct { background: linear-gradient(90deg, #ff0033, #ff1200, #0019ff, #ff1200, #ff0033); background-size: 300% 300%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: goldWhiteFlow 2s linear infinite, correctPop 800ms ease-out forwards; } 
        @keyframes correctPop { 0% { transform: scale(0.6); opacity: 0; } 25% { transform: scale(1.05); opacity: 1; } 85% { transform: scale(1.0); opacity: 1; } 100% { transform: scale(0.95); opacity: 0; } }
        
        .particle { position: absolute; width: 6px; height: 6px; border-radius: 50%; pointer-events: none; animation: particleBlow 0.5s cubic-bezier(0.1, 0.8, 0.3, 1) forwards; left: 50%; top: 50%; }
        @keyframes particleBlow { 0% { transform: translate(-50%, -50%) scale(1.2); opacity: 1; } 100% { transform: translate(calc(-50% + var(--mx)), calc(-50% + var(--my))) scale(0); opacity: 0; } }

        .txt-miss { background: linear-gradient(135deg, #00ff80, #00cccc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 32px; animation: missShake 1950ms ease-in-out forwards; width: 100%; text-align: center; } 
        .miss-ans-subtext { display: block; font-size: 14px; color: #000; font-weight: bold; background: rgba(0,0,0,0.08); padding: 8px 12px; border-radius: 6px; margin-top: 6px; border: 1px solid rgba(255,12,0,0.15); width: 100%; text-align: center; word-break: break-all; } 
        @keyframes missShake { 0% { transform: translateX(0) scale(0.9); opacity: 0; } 4%, 12%, 20%, 28% { transform: translateX(-4px); opacity: 1; } 8%, 16%, 24%, 32% { transform: translateX(4px); } 36% { transform: translateX(0) translateY(0); opacity: 1; } 88% { transform: translateY(0); opacity: 1; } 100% { transform: translateY(15px); opacity: 0; } }

        .txt-complete { background: linear-gradient(90deg, var(--acc), var(--shuffle), var(--p), var(--new), var(--gold)); background-size: 400% 400%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: rainbowFlow 4s linear infinite, completeZoom 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; font-size: 34px; font-weight: 900; text-align: center; margin-bottom: 12px; }
        @keyframes completeZoom { 0% { transform: scale(0.3); opacity: 0; } 50% { transform: scale(1.1); } 100% { transform: scale(1); opacity: 1; } }

        .confirm-btn-grid { display: flex; gap: 8px; margin-top: 15px; width: 100%; }
        .confirm-btn { flex: 1; padding: 10px; border: none; border-radius: 7px; font-size: 14px; font-weight: bold; cursor: pointer; }
    </style>
</head>
<body>

    <div class="city-bg-container">
        <div class="city-base-image"></div>
        <canvas id="highway-canvas"></canvas>
    </div>

    <div id="toast-container"></div>
    <div id="bg-effect-overlay"></div>

    <div id="confirm-modal" class="modal-overlay" style="z-index: 5000;">
        <div class="card" style="width:85%; max-width:330px; text-align: center;">
            <h3 style="margin-top:0;" id="confirm-title">最終確認</h3> 
            <p id="confirm-msg" style="font-size:13px; color:#342a1e; line-height:1.5; margin-bottom:15px;"></p> 
            <div class="confirm-btn-grid">
                <button class="confirm-btn" style="background:rgba(0,0,0,0.15);" id="confirm-cancel-btn">いいえ</button> 
                <button class="confirm-btn" style="background:linear-gradient(135deg, var(--danger), #33dbdb);" id="confirm-ok-btn">はい</button> 
            </div>
        </div>
    </div>

    <div id="complete-modal" class="modal-overlay">
        <div class="card" style="width:85%; max-width:350px; text-align: center; padding: 25px 15px;">
            <div class="txt-complete">🎉 COMPLETE !!</div>
            <p style="font-size:15px; font-weight:bold; margin: 0 0 15px 0;">すべてのクイズが終了しました！</p> 
            <button class="main-btn btn-p" onclick="closeModal('complete-modal')">戻る</button>
        </div>
    </div>

    <div id="list-modal" class="modal-overlay">
        <div class="card" style="width:85%; max-width:330px;">
            <h3 style="margin-top:0">移動先のフォルダを選択</h3>
            <select id="modal-pl-select"></select>
            <div style="display:flex; gap:8px; margin-top:10px;">
                <button class="main-btn" style="background:rgba(0,0,0,0.15); flex:1;" onclick="closeModal('list-modal')">戻る</button> 
                <button class="main-btn btn-p" style="flex:1;" onclick="executeAddToList()">移動する</button>
            </div>
        </div>
    </div>

    <div id="edit-modal" class="modal-overlay">
        <div class="card" style="width:85%; max-width:330px;">
            <h3 style="margin-top:0">単語を編集</h3>
            <label style="font-size:11px; color:#543f2f;">English</label> <input id="edit-en-in" type="text" autocomplete="off">
            <label style="font-size:11px; color:#543f2f;">日本語</label> <input id="edit-ja-in" type="text" autocomplete="off">
            <div style="display:flex; gap:8px; margin-top:12px;">
                <button class="main-btn" style="background:rgba(0,0,0,0.15); flex:1;" onclick="closeModal('edit-modal')">戻る</button> 
                <button class="main-btn btn-edit" style="flex:1;" onclick="executeEditWord()">更新</button>
            </div>
        </div>
    </div>

    <div id="page-add" class="page">
        <div class="card">
            <h2 style="margin:0 0 12px 0; color:var(--p); text-shadow:0 0 6px rgba(255,12,0,0.2)">単語を登録</h2> 
            <label style="font-size:11px; color:#543f2f; font-weight:bold;">追加先フォルダ</label> 
            <select id="add-to-playlist" style="margin-top:4px; margin-bottom:12px;"></select>

            <div class="sub-tabs">
                <div id="sub-tab-single" class="sub-tab sub-tab-active" onclick="switchAddMode('single')">1件ずつ登録</div>
                <div id="sub-tab-bulk" class="sub-tab" onclick="switchAddMode('bulk')">AI一括登録</div>
            </div>

            <div id="add-single-container" style="width: 100%;">
                <input id="en-in" type="text" placeholder="English" autocomplete="off" onkeydown="if(event.key==='Enter' && this.value.trim() !== '') { event.preventDefault(); setTimeout(() => { document.getElementById('ja-in').focus(); }, 10); }">
                <input id="ja-in" type="text" placeholder="日本語" autocomplete="off" onkeydown="if(event.key==='Enter') saveWord()">
                <button class="main-btn btn-p" onclick="saveWord()">保存する</button>
            </div>

            <div id="add-bulk-container" class="hidden" style="width: 100%;">
                <textarea id="bulk-import-area" placeholder="rational, 合理的な&#10;irrational, 非合理的な"></textarea>
                <button class="main-btn btn-p" style="background:linear-gradient(135deg, var(--new), #ff4c70); margin-bottom: 8px;" onclick="saveBulkWords()">一括保存する</button> 
                <div class="prompt-example-box">
                    <span style="font-weight: bold; color: var(--p);">💡 AIへのフォーマット指示</span>
                    <div class="prompt-code-block" id="prompt-text-template">hurtle, 突進する
lineage, 血統
accomplish, 達成</div>
                </div>
            </div>
        </div>
    </div>

    <div id="page-quiz" class="page active">
        <div class="card" id="quiz-main-card">
            <div id="count-area" class="countdown hidden"></div>
            <div id="q-display" class="q-text">クイズ道場</div>
            
            <div id="quiz-ui-container">
                <div id="quiz-effect-layer"></div>

                <div id="quiz-ui" class="hidden">
                    <input id="ans-in" type="text" placeholder="答えを入力" style="text-align:center;" autocomplete="off" onkeydown="if(event.key==='Enter') handleCheck()">
                    <button class="main-btn btn-p" onclick="handleCheck()">決定</button>
                </div>
                <div id="choice-ui" class="hidden">
                    <div id="wait-area">
                        <div id="wait-timer" class="wait-timer">選択肢表示まであと 8 秒</div>
                        <button class="main-btn btn-sub" style="width:100%; margin-bottom:8px;" onclick="skipWait()">今すぐ表示</button>
                    </div>
                    <div id="choices-grid" class="choices-grid hidden"></div>
                </div>
            </div>

            <div id="abort-ui" class="abort-container hidden">
                <button class="btn-sub" style="background:none; border:none; text-decoration:underline;" onclick="abortQuiz()">クイズを中止する</button>
            </div>

            <div id="quiz-setup" style="width: 100%;">
                <p style="text-align:center; font-weight: bold;">対象: <select id="quiz-from-playlist" style="width:auto; display:inline-block; padding:6px 10px; margin:0; background:rgba(0,0,0,0.95); color:var(--text-dark);"></select></p>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom:8px;">
                    <button class="main-btn" style="background: linear-gradient(135deg, #cb8b4a, #d6a470);" onclick="startQuiz('new')">新規(4択)</button>
                    <button class="main-btn" style="background: linear-gradient(135deg, #bb738b, #ca94a6);" onclick="startQuiz('srs')">復習(6択)</button>
                </div>
                <button class="main-btn" style="background: linear-gradient(135deg, #4196af, #69b4c8); margin-bottom: 8px;" onclick="startQuiz('miss')">苦手特訓(4択)</button>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                    <button class="main-btn" style="background: linear-gradient(135deg, #919b73, #aab491);" onclick="startQuiz('all_choice')">既習(選択)</button>
                    <button class="main-btn" style="background: linear-gradient(135deg, #919b73, #aab491);" onclick="startQuiz('all')">既習(入力)</button>
