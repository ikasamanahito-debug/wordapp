        <div id="bulk-action-bar" class="bulk-action-bar hidden">
            <div style="font-size:11px; font-weight:bold; margin-bottom:6px; color:var(--p);">一括操作メニュー (<span id="selected-count">0</span>件選択中)</div>
            <div style="display:flex; gap:6px; flex-wrap:wrap;">
                <button class="btn-sub" style="background:var(--p); color:var(--text-dark); border:none;" onclick="openBulkMoveModal()">フォルダ移動</button>
                <button class="btn-sub" style="background:var(--shuffle); color:var(--text-dark); border:none;" onclick="executeBulkResetSRS()">SRS初期化</button>
                <button class="btn-d" onclick="executeBulkDelete()">削除</button>
